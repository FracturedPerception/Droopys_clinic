@startuml Droopy's_clinic Use-case
left to right direction

actor "Врач" as Doc
actor "Администратор" as Admn
actor "Пациент" as Lho

rectangle "Droopy's_clinic"{

    usecase "Регистрация Пациента" as UC_RegLho
